<div id="loadingSpinner" hidden="hidden">
    <div class="u-inline-011">
        <div id="loadingMessage" class="loading-message">Processing your request</div>
        <div class="overlay u-inline-132">
            <div class="ball a"></div>
            <div class="ball b"></div>
            <div class="ball c"></div>
        </div>
        <div class="u-inline-197">
            <div class="u-inline-098"><i class="fa-solid fa-book-open-reader"></i></div>Example query:<br>
            <b>label {not_contains} dsx</b><br>Finds neurons with a label that does not contain the substring 'dsx'<br><br>Additional query examples in <a href="/sample_queries" target="_blank"><b>Navbar → <i class="fa-regular fa-circle-question"></i> → Sample Queries</b></a>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.js" integrity="sha256-H+K7U5CnXl1h5ywQfKtSj8PCmoN9aaq30gDh27Xc0jk=" crossorigin="anonymous" defer></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js" integrity="sha384-LtrjvnR4Twt/qOuYxE721u19sVFLVSA4hf/rRt6PrZTmiPltdZcI7q7PXQBYTKyf" crossorigin="anonymous" defer></script>

<script type="text/javascript">
    function loading(evnt = false, message = "Processing your request") {
        if (typeof evnt === "string") {
            message = evnt;
            evnt = false;
        }
        // Check if Ctrl or Cmd key is pressed to open in a new tab without showing the spinner
        if (evnt && (evnt.ctrlKey || evnt.metaKey)) {
            clear_loading();
        } else {
            document.getElementById("loadingMessage").textContent = message.slice(0, 100) || "Processing your request";
            document.getElementById("contentBody").hidden = true;
            document.getElementById("loadingSpinner").hidden = false;
        }
    }

    let exodiacLoadingTimer;

    function loadingExodiac(event, question = "") {
        window.clearInterval(exodiacLoadingTimer);
        question = question || document.getElementById("question")?.value.trim() || "";
        loading(event, "Searching inside Codex, literature & web for: " + question);
        if (document.getElementById("loadingSpinner").hidden) return;

        const messages = [
            "Checking Codex query syntax and dataset specific attributes..",
            "Searching annotations and metadata..",
            "Checking cell types in all datasets..",
            "Searching FlyWire papers..",
            "Preparing a concise answer.."
        ];
        let messageIndex = 0;

        function showNextMessage() {
            if (document.getElementById("loadingSpinner").hidden) {
                window.clearInterval(exodiacLoadingTimer);
                return;
            }
            if (messageIndex < messages.length) {
                document.getElementById("loadingMessage").textContent = messages[messageIndex++];
            } else {
                document.getElementById("loadingMessage").textContent = "Waiting for Exodiac's response..";
                window.clearInterval(exodiacLoadingTimer);
            }
        }

        showNextMessage();
        exodiacLoadingTimer = window.setInterval(showNextMessage, 2500);
    }

    function clear_loading() {
        window.clearInterval(exodiacLoadingTimer);
        document.getElementById("contentBody").hidden = false;
        document.getElementById("loadingMessage").textContent = "Processing your request";
        document.getElementById("loadingSpinner").hidden = true;
    }

    window.addEventListener("pagehide", clear_loading);
    window.addEventListener("pageshow", clear_loading);

    function applyDesktopAutofocus() {
      const isMobileLike =
        window.matchMedia("(pointer: coarse)").matches ||
        /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      if (isMobileLike) {
        return;
      }
      const candidates = document.querySelectorAll(
        "input[data-desktop-autofocus='1'][type='search']"
      );
      let target = null;
      for (const elem of candidates) {
        const isVisible = elem.getClientRects().length > 0 && !elem.closest("[hidden]");
        const isEnabled = !elem.disabled && elem.tabIndex !== -1;
        const isEmpty = !elem.value || elem.value.trim() === "";
        if (isVisible && isEnabled && isEmpty) {
          target = elem;
          break;
        }
      }
      if (!target) {
        return;
      }
      const focusTarget = () => {
        if (document.activeElement !== target) {
          try {
            target.focus({preventScroll: true});
          } catch (e) {
            target.focus();
          }
        }
      };
      window.requestAnimationFrame(focusTarget);
      window.setTimeout(focusTarget, 120);
    }

    function toast(evnt = false, message) {
      const t = document.createElement("div");
      t.textContent = message;
      t.className = "app-toast";

      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3000);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    const THEME_PREF_KEY = "codex-theme-pref";
    const lightModeMedia = window.matchMedia("(prefers-color-scheme: light)");

    function resolveTheme(preference) {
      if (preference === "dark" || preference === "light") {
        return preference;
      }
      return lightModeMedia.matches ? "light" : "dark";
    }

    function sendThemeEvent(theme, previousTheme, source) {
      const payload = JSON.stringify({
        theme: theme,
        previous_theme: previousTheme,
        source: source,
        path: window.location.pathname,
      });
      if (navigator.sendBeacon) {
        const blob = new Blob([payload], {type: "application/json"});
        navigator.sendBeacon("/theme_event", blob);
        return;
      }
      fetch("/theme_event", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: payload,
        keepalive: true,
      }).catch(() => {});
    }

    function applyTheme(theme, source = "manual", shouldLog = false) {
      const root = document.documentElement;
      const previousTheme = root.getAttribute("data-theme") || "light";
      root.setAttribute("data-theme", theme);

      const button = document.getElementById("theme-toggle-btn");
      if (button) {
        button.classList.toggle("is-dark", theme === "dark");
        button.setAttribute("aria-pressed", String(theme === "dark"));
      }

      if (shouldLog && previousTheme !== theme) {
        sendThemeEvent(theme, previousTheme, source);
      }
    }

    function initializeTheme() {
      const storedPref = localStorage.getItem(THEME_PREF_KEY);
      applyTheme(resolveTheme(storedPref), "initial", false);

      const button = document.getElementById("theme-toggle-btn");
      if (button) {
        button.addEventListener("click", () => {
          const currentTheme = document.documentElement.getAttribute("data-theme") || "light";
          const nextTheme = currentTheme === "dark" ? "light" : "dark";
          localStorage.setItem(THEME_PREF_KEY, nextTheme);
          sendThemeEvent(nextTheme, currentTheme, "toggle_button");
          loading("Applying theme");
          window.location.reload();
        });
      }

      const onSystemThemeChange = () => {
        const pref = localStorage.getItem(THEME_PREF_KEY);
        if (!pref) {
          applyTheme(resolveTheme(pref), "system", true);
        }
      };
      if (lightModeMedia.addEventListener) {
        lightModeMedia.addEventListener("change", onSystemThemeChange);
      } else if (lightModeMedia.addListener) {
        lightModeMedia.addListener(onSystemThemeChange);
      }
    }

    document.addEventListener("DOMContentLoaded", function() {
      initializeTheme();
      applyDesktopAutofocus();
    });
</script>

</body>
</html>